# Hall Pass — environment variables. Copy to .env for local development
# (cp .env.example .env). Never commit real values: .env is ignored.

# --- Database (Postgres). Unless DATABASE_TARGET=neon, the app uses the first one that answers. --
# Pooled connection the app runs on.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hallpass
# Direct (unpooled) connection, used for migrations and as a fallback.
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hallpass
# Database the unit tests use (wiped by the tests; never point at real data).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hallpass_test
# Neon names, set by the Vercel integration: POSTGRES_URL is pooled (the app with DATABASE_TARGET=neon).
# POSTGRES_URL=
# Neon's direct connection (migrations, backups and the move tool with DATABASE_TARGET=neon).
# DATABASE_URL_UNPOOLED=
# The same direct connection under its other name, used when DATABASE_URL_UNPOOLED is unset.
# POSTGRES_URL_NON_POOLING=
# neon on Vercel production after the move (POSTGRES_URL only, no fallback); unset or "auto" locally.
# DATABASE_TARGET=
# Switches on the one-off move tool /api/admin/move-database (openssl rand -hex 32); unset or "off" = off.
# MOVE_DATABASE_TOKEN=

# --- Sign-in (Better Auth, in this database). Leave unset locally for demo sign-in. --
# Long random secret that signs sessions and tokens (openssl rand -base64 32). On
# Vercel production, when unset, it is derived from CRON_SECRET instead.
# BETTER_AUTH_SECRET=
# 1 = rate-limit sign-in outside production too (always on in production).
# AUTH_RATE_LIMIT=1
# 1 = demo sign-in as the seeded …@….test users (never on Vercel production); remove for real use.
# DEV_AUTH=1

# --- Files: an S3-compatible bucket (Cloudflare R2 recommended). ------------
# S3_BUCKET=hall-pass
# Endpoint origin, e.g. https://<account id>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Region; R2 uses "auto" (the default).
# S3_REGION=auto
# Alternative store: Vercel Blob token (a bucket takes precedence when both are set).
# BLOB_READ_WRITE_TOKEN=

# --- Jobs, email and calendar feeds. ----------------------------------------
# Any long random string; Vercel Cron sends it to /api/cron/daily (on Vercel production
# it also seeds the sign-in secret when BETTER_AUTH_SECRET is unset).
CRON_SECRET=dev-cron-secret
# Signs calendar feed links; falls back to CRON_SECRET.
# ICAL_SECRET=
# Transactional email via Resend; sign-in links, resets and invitations are only logged
# until BOTH are set.
# RESEND_API_KEY=
# EMAIL_FROM="Hall Pass <hallpass@example.com>"

# --- App settings (all optional). -------------------------------------------
# Public address (sign-in and reset links use it); auto-detected from the Vercel domain when unset.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Product name shown in the app and emails (default "Hall Pass").
# NEXT_PUBLIC_BRAND_NAME=Hall Pass
# Time zone for dates and "today" (default Europe/London).
# APP_TIMEZONE=Europe/London
# 1 = show stand approvals (hidden by default).
# STANDS_ENABLED=1

# --- Seed only (pnpm db:seed). ----------------------------------------------
# starter = an empty organisation and its first super admin, no demo data.
# SEED_MODE=starter
# FIRST_ADMIN_EMAIL=you@company.com
# FIRST_ADMIN_NAME=
# ORG_NAME="Your company"
# ORG_SLUG=
# BRAND_NAME=
